# ==========================================
# Professional .gitignore for Python / ML / Streamlit Projects
# ==========================================

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- Python & Bytecode Caches ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- IDEs & Code Editors ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# --- Jupyter Notebook Artifacts ---
.ipynb_checkpoints/
*-checkpoint.ipynb

# --- Machine Learning Models & Large Artifacts ---
*.joblib
*.pkl
*.pickle
*.h5
*.hdf5
*.pth
*.pt
*.onnx
*.tflite
*.pb
house_price_model.joblib

# --- Environment Variables & Secrets ---
.env
.env.*
!.env.example
.streamlit/secrets.toml

# --- Testing & Code Quality ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.hypothesis/

# --- Local AI & Agent Metadata ---
.agents/
.claude/
.gemini/